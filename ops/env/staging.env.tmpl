# Staging server env template. team-provision writes shared/.env (chmod 600) from it once,
# filling the {{KEY}} placeholders; existing values are never overwritten and new keys are
# appended on later runs. {{RANDOM_SECRET}} becomes a fresh 32-byte hex value per occurrence.
# Never put real values in this file: it is committed, and the repo may be public.
APP_ENV=staging
PORT={{PORT}}
APP_URL={{APP_URL}}
APP_TIMEZONE={{APP_TIMEZONE}}
APP_SECRET={{RANDOM_SECRET}}

DB_HOST={{DB_HOST}}
DB_PORT={{DB_PORT}}
DB_NAME={{DB_NAME}}
DB_USER={{DB_USER}}
DB_PASSWORD={{DB_PASSWORD}}

# Outside services: staging uses each provider's sandbox mode and sandbox keys only.
# Add the sandbox keys on the server by hand (never here).
MAIL_MODE=sandbox
SMS_MODE=sandbox
PAYMENTS_MODE=sandbox
WEBHOOKS_MODE=sandbox

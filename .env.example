# Worktree env file template (KEY=value lines; comments on their own lines).
# team-new-worktree copies this to .env (ENV_FILE in ops/project.conf) for each worktree
# and fills PORT, APP_URL, APP_TIMEZONE, the DB_* keys, DATABASE_URL and
# PLAYWRIGHT_PROFILE_DIR. Never commit .env. Server env files come from ops/env/*.tmpl.

# App
PORT=8000
APP_URL=http://localhost:8000
# IANA timezone of the project's users, same as PROJECT_TIMEZONE in ops/project.conf
# (for example Asia/Manila or America/New_York). Store and log in UTC; use this for display.
APP_TIMEZONE=
APP_ENV=local

# Database: always an explicit host and port, never a default socket.
# Postgres worktree databases live on the local server; MySQL/MariaDB use a project container.
DB_HOST=127.0.0.1
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# Only if the stack reads a single URL; team-new-worktree fills it when the key exists.
DATABASE_URL=

# Browser tests (Playwright) keep their profile per worktree
PLAYWRIGHT_PROFILE_DIR=.team/playwright-profile

# Set to 1 by team-new-worktree
TEAM_WORKTREE=

# Outside services: local runs never send real email, SMS, payments or webhooks.
# log = write what would be sent to the app log; sandbox = the provider's test mode and test keys.
MAIL_MODE=log
SMS_MODE=log
PAYMENTS_MODE=sandbox
WEBHOOKS_MODE=log

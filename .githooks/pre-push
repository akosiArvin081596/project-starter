#!/usr/bin/env bash
# pre-push: (1) never push to main or push tags: main changes only through squash-merged PRs,
# and only release-please creates version tags; (2) branch names follow
# <type>/<issue>-<slug> (types: feat fix chore docs refactor hotfix); (3) `make lint test`
# pass. A target that isn't configured yet is skipped with a notice.
# Git passes "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.
# Installed by `make hooks` (team-hooks). bash 3.2 compatible.
set -euo pipefail

NOT_CONFIGURED_TEXT='not configured: fill in for your stack'
BRANCH_PATTERN='^(feat|fix|chore|docs|refactor|hotfix)/([0-9]+-)?[a-z0-9][a-z0-9.-]*$'
ZERO_SHA_PATTERN='^0+$'

remote_name="${1:-origin}"

root=$(git rev-parse --show-toplevel)
cd "$root"

run_target() {
  local target="$1" log rc last
  log=$(mktemp "${TMPDIR:-/tmp}/githook-make.XXXXXX")
  set +e
  make --no-print-directory "$target" 2>&1 | tee "$log"
  rc=${PIPESTATUS[0]}
  set -e
  if [ "$rc" -ne 0 ]; then
    last=$(grep -E '^make(\[[0-9]+\])?: \*\*\* ' "$log" | tail -n 1 || true)
    case "$last" in
      *'Error 3') rc=3 ;;
    esac
    if [ "$rc" -ne 3 ] && grep -qF "$NOT_CONFIGURED_TEXT" "$log"; then
      rc=3
    fi
    [ "$rc" -eq 3 ] || rc=1
  fi
  rm -f "$log"
  return "$rc"
}

blocked=0
updates=0
while read -r local_ref local_sha remote_ref _remote_sha; do
  [ -n "${remote_ref:-}" ] || continue
  case "$remote_ref" in
    refs/heads/main)
      echo "pre-push: blocked: pushing to main ($remote_name). Push your branch and open a PR; main changes only through squash merges." >&2
      blocked=1; continue ;;
    refs/tags/*)
      echo "pre-push: blocked: pushing tag ${remote_ref#refs/tags/}. Only release-please creates version tags." >&2
      blocked=1; continue ;;
    refs/heads/*) ;;
    *)
      echo "pre-push: blocked: $remote_ref is not a branch. Only branches are pushed." >&2
      blocked=1; continue ;;
  esac
  branch="${remote_ref#refs/heads/}"
  if ! [[ "$branch" =~ $BRANCH_PATTERN ]]; then
    {
      echo "pre-push: blocked: branch name '$branch' must look like <type>/<issue>-<slug>"
      echo "  types: feat fix chore docs refactor hotfix; slug: lowercase letters, digits, dots, dashes"
      echo "  e.g.   feat/12-login, fix/7-export-timezone, chore/initial-stack"
    } >&2
    blocked=1; continue
  fi
  # A deletion ("(delete)" with an all-zero local sha) runs no checks.
  if [[ "$local_sha" =~ $ZERO_SHA_PATTERN ]] || [ "$local_ref" = "(delete)" ]; then
    continue
  fi
  updates=$((updates + 1))
done

if [ "$blocked" -ne 0 ]; then
  exit 1
fi
if [ "$updates" -eq 0 ]; then
  exit 0
fi

for target in lint test; do
  status=0
  run_target "$target" || status=$?
  case "$status" in
    0) ;;
    3) echo "pre-push: notice: make $target is not configured yet; skipped." >&2 ;;
    *) echo "pre-push: make $target failed; fix it before pushing." >&2; exit 1 ;;
  esac
done

exit 0

#!/usr/bin/env bash
# commit-msg: the subject line must follow Conventional Commits, because PR titles (checked
# the same way in CI) become the squash commits on main.
#   <type>[(scope)][!]: <description>     e.g. feat(auth): add password reset
# Types (same as dev-standards config/pr-title-types.txt): feat fix hotfix chore docs
# refactor perf test build ci style revert. "!" marks a breaking change.
# Also allowed: git's own merge subjects ("Merge ...") and fixup!/squash!/amend! subjects
# for local history. Installed by `make hooks` (team-hooks). bash 3.2 compatible.
set -euo pipefail

msg_file="${1:-}"
if [ -z "$msg_file" ] || [ ! -r "$msg_file" ]; then
  echo "commit-msg: usage: commit-msg <message-file>" >&2
  exit 2
fi

# The subject is the first line that is neither blank nor a comment (git strips comments later).
subject=""
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in
    '#'*) continue ;;
  esac
  trimmed="${line#"${line%%[![:space:]]*}"}"
  [ -n "$trimmed" ] || continue
  subject="$line"
  break
done < "$msg_file"

if [ -z "$subject" ]; then
  echo "commit-msg: empty commit message" >&2
  exit 1
fi

case "$subject" in
  'Merge '*|'fixup! '*|'squash! '*|'amend! '*) exit 0 ;;
esac

types='feat|fix|hotfix|chore|docs|refactor|perf|test|build|ci|style|revert'
pattern="^(${types})(\\([A-Za-z0-9._/-]+\\))?!?: [^[:space:]].*$"

if [[ "$subject" =~ $pattern ]]; then
  exit 0
fi

{
  echo "commit-msg: the subject must follow Conventional Commits:"
  echo "  <type>[(scope)][!]: <description>"
  echo "  types: ${types//|/ }"
  echo "  e.g.   feat(auth): add password reset"
  echo "         fix!: change the export date format"
  echo "got: $subject"
} >&2
exit 1
